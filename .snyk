# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.0

# Language-specific settings
language-settings:
  javascript:
    # Ignore devDependencies vulnerabilities by default
    ignoreDevDependencies: false

# Ignore specific vulnerabilities
# Format:
#   'SNYK-{LANGUAGE}-{PACKAGE}-{ID}':
#     - '{PACKAGE}@{VERSION}':
#         reason: 'Explanation for ignoring this vulnerability'
#         expires: 'YYYY-MM-DDTHH:MM:SS.000Z'
#         created: 'YYYY-MM-DDTHH:MM:SS.000Z'
ignore:
  # Example: Ignore a low-severity vulnerability in a dev dependency
  # 'SNYK-JS-EXAMPLE-123456':
  #   - 'example-package@1.0.0':
  #       reason: 'Dev dependency only, not used in production'
  #       expires: '2026-12-31T23:59:59.000Z'
  #       created: '2025-01-15T00:00:00.000Z'

# Patch specific vulnerabilities (if patches are available)
patch: {}

# Usage Instructions:
# 1. Run `npx snyk test` to scan for vulnerabilities
# 2. To ignore a specific vulnerability, add it to the 'ignore' section above
# 3. Always provide a reason and expiration date for ignored vulnerabilities
# 4. Use `npx snyk wizard` for interactive vulnerability management
# 5. Review and update this file regularly, especially before expiration dates
#
# Best Practices:
# - Only ignore vulnerabilities after careful risk assessment
# - Set reasonable expiration dates (typically 3-6 months)
# - Document the business justification in the 'reason' field
# - Prioritize fixing over ignoring when possible
# - Review expired ignores during security audits
